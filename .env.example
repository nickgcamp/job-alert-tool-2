# Copy to .env for local runs (`set -a; source .env; set +a`). Never commit .env.
# In GitHub, add these as repository secrets instead (Settings > Secrets and variables > Actions).

# Email alerts through Gmail. SMTP_PASSWORD is a Gmail *app password* (needs 2-Step Verification on).
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Phone push through the free ntfy app. Pick a long random topic name; anyone who knows it can read it.
NTFY_TOPIC=

# Optional: fit scoring with Claude
ANTHROPIC_API_KEY=
# Either paste your resume as plain text here, or save it as resume.txt next to config.yaml.
RESUME_TEXT=

# Optional: Postgres instead of the local SQLite file
DATABASE_URL=
